{
  "info": {
    "name": "Search Scraper API (DuckDuckGo, Brave & Google)",
    "description": "Postman collection for the local Scraper API (DuckDuckGo, Brave HTTP, Brave Playwright, Google Playwright) plus direct requests to the search engines. Start the server first: `python3 server.py` (default http://localhost:8080). Folders 1-4 include tests that check status, result count, contiguous positions and page counts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "pages",
      "value": "3",
      "type": "string"
    },
    {
      "key": "deepPages",
      "value": "10",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. DuckDuckGo Scraper (Local API)",
      "item": [
        {
          "name": "Local DDG - GET Multi-Page Search (x Pages)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=machine+learning&pages={{pages}}&region=us-en&engine=ddg&method=POST",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "machine learning",
                  "description": "Search query terms"
                },
                {
                  "key": "pages",
                  "value": "{{pages}}",
                  "description": "Number of pages to scrape (e.g. 1, 2, 3, 5)"
                },
                {
                  "key": "region",
                  "value": "us-en",
                  "description": "Region / Language code (e.g. us-en, uk-en, de-de)"
                },
                {
                  "key": "engine",
                  "value": "ddg",
                  "description": "Engine to use: 'ddg', 'brave', 'brave-playwright' or 'google'"
                },
                {
                  "key": "method",
                  "value": "POST",
                  "description": "DDG request method (POST recommended to avoid bot anomaly page)"
                }
              ]
            },
            "description": "Scrapes 'x' pages sequentially from DuckDuckGo, automatically chaining vqd tokens and returning contiguous positions (1..N)."
          }
        },
        {
          "name": "Local DDG - POST Multi-Page Search (JSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"python asyncio tutorial\",\n  \"pages\": 3,\n  \"region\": \"us-en\",\n  \"engine\": \"ddg\",\n  \"method\": \"POST\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ]
            },
            "description": "Sends search query, target page count, and engine in JSON body. Returns unified JSON results."
          }
        },
        {
          "name": "Local DDG - Single Page Search (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=fastapi+tutorial&pages=1&region=us-en&engine=ddg&method=POST",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "fastapi tutorial"
                },
                {
                  "key": "pages",
                  "value": "1"
                },
                {
                  "key": "region",
                  "value": "us-en"
                },
                {
                  "key": "engine",
                  "value": "ddg",
                  "description": "Engine to use: 'ddg', 'brave', 'brave-playwright' or 'google'"
                },
                {
                  "key": "method",
                  "value": "POST"
                }
              ]
            },
            "description": "Standard single-page DDG search returning top results."
          }
        },
        {
          "name": "Local DDG - Deep Search (10 pages)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=python+web+scraping&pages={{deepPages}}&region=us-en&engine=ddg&method=POST",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "python+web+scraping"
                },
                {
                  "key": "pages",
                  "value": "{{deepPages}}"
                },
                {
                  "key": "region",
                  "value": "us-en"
                },
                {
                  "key": "engine",
                  "value": "ddg"
                },
                {
                  "key": "method",
                  "value": "POST"
                }
              ]
            },
            "description": "Regression test for the old page-3 cap. Before the curl_cffi fix, page 4 returned HTTP 202 (cc=botnet)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"went past page 3\", () => pm.expect(pm.response.json().pages_scraped).to.be.above(3));"
                ]
              }
            }
          ]
        }
      ],
      "description": "DDG through curl_cffi (Chrome TLS impersonation). Pages chain vqd tokens automatically.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"status is ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
              "pm.test(\"has results\", () => pm.expect(body.results.length).to.be.above(0));",
              "pm.test(\"results_count matches results\", () => pm.expect(body.results_count).to.eql(body.results.length));",
              "pm.test(\"positions are contiguous from 1\", () => body.results.forEach((r, i) => pm.expect(r.position).to.eql(i + 1)));"
            ]
          }
        }
      ]
    },
