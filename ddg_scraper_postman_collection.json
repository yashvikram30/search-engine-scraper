        {
          "name": "Local Brave HTTP - Page Cap Check (pages=15)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=pokemon&pages=15&engine=brave",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "pokemon"
                },
                {
                  "key": "pages",
                  "value": "15"
                },
                {
                  "key": "engine",
                  "value": "brave"
                }
              ]
            },
            "description": "Asks for more pages than Brave has. Expect status ok with about 6 pages scraped, not an error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"capped at 6 pages\", () => pm.expect(pm.response.json().pages_scraped).to.be.at.most(6));"
                ]
              }
            }
          ]
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"status is ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
              "pm.test(\"has results\", () => pm.expect(body.results.length).to.be.above(0));",
              "pm.test(\"results_count matches results\", () => pm.expect(body.results_count).to.eql(body.results.length));",
              "pm.test(\"positions are contiguous from 1\", () => body.results.forEach((r, i) => pm.expect(r.position).to.eql(i + 1)));",
              "pm.test(\"no duplicate URLs\", () => {",
              "  const urls = body.results.map(r => r.url);",
              "  pm.expect(new Set(urls).size).to.eql(urls.length);",
              "});"
            ]
          }
        }
      ],
      "description": "Brave over HTTP. Brave returns about 6 pages (~120 results) per query; page 7 comes back empty."
    },
