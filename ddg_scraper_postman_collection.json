    {
      "name": "4. Google Scraper - Playwright Browser (Local API)",
      "description": "Google needs a real browser, so this opens a visible Chrome window (set GOOGLE_HEADLESS=1 to hide it; headless is more likely to be blocked). Searches run one at a time, with a 3-8s pause between pages, so 3 pages take roughly 15-25s. Google returns 10 results per page. A status of 'blocked' means Google served a CAPTCHA or consent page; wait before retrying and check debug_google.html.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"status is ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
              "pm.test(\"has results\", () => pm.expect(body.results.length).to.be.above(0));",
              "pm.test(\"results_count matches results\", () => pm.expect(body.results_count).to.eql(body.results.length));",
              "pm.test(\"positions are contiguous from 1\", () => body.results.forEach((r, i) => pm.expect(r.position).to.eql(i + 1)));",
              "pm.test(\"no duplicate URLs\", () => {",
              "  const urls = body.results.map(r => r.url);",
              "  pm.expect(new Set(urls).size).to.eql(urls.length);",
              "});",
              "pm.test(\"each page adds results (about 10 per page)\", () => pm.expect(body.results.length).to.be.at.least(body.pages_scraped * 5));"
            ]
          }
        }
      ],
